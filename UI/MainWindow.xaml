<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework" xmlns:local="clr-namespace:Common.Configs;assembly=Configs"
        Title="Моделирование увлажнения почвы" Height="600" Width="800">
    <Window.DataContext>
        <local:MoistureSimulationConfig x:Name="Config"/>
    </Window.DataContext>
    
    <TabControl>
        <TabItem Header="Simulation" FontSize="18">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="Black" BorderThickness="1" Margin="5,5,5,5">
                    <Image Name="SimulationImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,10,10,10">
                    <TextBlock Text="Легенда:" FontWeight="Bold" Margin="0 0 0 5"/>
                    <StackPanel Orientation="Horizontal" Margin="0 2">
                        <Rectangle Width="20" Height="20" Fill="White" Stroke="Black"/>
                        <TextBlock Text=" – Сухая почва" VerticalAlignment="Center" Margin="5 0 0 0" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 2">
                        <Rectangle Width="20" Height="20" Fill="LightBlue" Stroke="Black"/>
                        <TextBlock Text=" – Умеренная влажность" VerticalAlignment="Center" Margin="5 0 0 0" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 2">
                        <Rectangle Width="20" Height="20" Fill="Blue" Stroke="Black"/>
                        <TextBlock Text=" – Максимальная влажность" VerticalAlignment="Center" Margin="5 0 0 0" FontSize="16"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 2">
                        <Rectangle Width="20" Height="20" Fill="Black"/>
                        <TextBlock Text=" – Трещина" VerticalAlignment="Center" Margin="5 0 0 0" FontSize="16"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="113,5,0,5" Width="635" >
                    <Button Name="StartButton" Content="Пуск" Width="80" Margin="5" Click="StartButton_Click" FontSize="18"/>
                    <Button Name="StopButton" Content="Стоп" Width="80" Margin="5" Click="StopButton_Click" FontSize="18"/>
                    <Button Name="SaveButton" Content="Сохранить" Width="103" Margin="5" Click="SaveButton_Click" FontSize="18"/>
                    <Button Name="LoadButton" Content="Загрузить" Width="98" Margin="5" Click="LoadButton_Click" FontSize="18"/>
                    <Button Name="RestartButton" Content="Рестарт" Width="80" Margin="5" Click="RestartButton_Click" FontSize="18"/>
                    <Button Content="График" Width="80" Margin="5" Click="GraphButton_Click" FontSize="18"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Settings" FontSize="18">
            <ScrollViewer>
                <Grid Margin="10" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="label"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60" SharedSizeGroup="value"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Text="Ширина сетки:" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="0" Grid.Column="1" x:Name="WidthSlider"
                Minimum="10" Maximum="500" Value="100"
                TickFrequency="10" IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2"
                 Text="{Binding ElementName=WidthSlider, Path=Value, StringFormat=N0}"
                 VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1" Text="Высота сетки:" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="1" Grid.Column="1" x:Name="HeightSlider"
                Minimum="10" Maximum="200" Value="100"
                TickFrequency="10" IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="2"
                 Text="{Binding ElementName=HeightSlider, Path=Value, StringFormat=N0}"
                 VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2" Text="Проницаемость (K):" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="2" Grid.Column="1" x:Name="ConductivitySlider"
                Minimum="0" Maximum="1" Value="0.1"
                TickFrequency="0.1" IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2"
                 Text="{Binding ElementName=ConductivitySlider, Path=Value, StringFormat=F2}"
                 VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="3" Text="Шаг времени (dt):" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="3" Grid.Column="1" x:Name="TimeStepSlider"
                Minimum="0" Maximum="1" Value="0.1"
                TickFrequency="0.1" IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="2"
                 Text="{Binding ElementName=TimeStepSlider, Path=Value, StringFormat=F2}"
                 VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="4" Text="Начальная влажность (%):" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="4" Grid.Column="1" x:Name="InitialMoistureSlider"
                Minimum="0" Maximum="100" Value="50"
                TickFrequency="10" IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Grid.Column="2"
                 Text="{Binding ElementName=InitialMoistureSlider, Path=Value, StringFormat=N0}"
                 VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="5" Text="Вероятность трещин (%):" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="5" Grid.Column="1" x:Name="CrackChanceSlider"
                Minimum="1" Maximum="100" Value="1"
                TickFrequency="1" IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="5" Grid.Column="2"
                 Text="{Binding ElementName=CrackChanceSlider, Path=Value, StringFormat=N0}"
                 VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="6" Text="Дождь (мм/шаг):" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="6" Grid.Column="1" x:Name="RainSlider"
                Minimum="0" Maximum="200" Value="5"
                TickFrequency="5" SmallChange="0.5" LargeChange="1"
                IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="6" Grid.Column="2"
                 Text="{Binding ElementName=RainSlider, Path=Value, StringFormat='{}{0:F1} мм'}"
                 VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="8" Text="ThetaS:" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="8" Grid.Column="1" x:Name="ThetaSSlider"
                Minimum="0" Maximum="1" Value="0.43"
                TickFrequency="0.01" IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="8" Grid.Column="2"
                 Text="{Binding ElementName=ThetaSSlider, Path=Value, StringFormat=F3}"
                 VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="9" Text="ThetaR:" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="9" Grid.Column="1" x:Name="ThetaRSlider"
                Minimum="0" Maximum="1" Value="0.078"
                TickFrequency="0.005" IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="9" Grid.Column="2"
                 Text="{Binding ElementName=ThetaRSlider, Path=Value, StringFormat=F3}"
                 VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="10" Text="Alpha:" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="10" Grid.Column="1" x:Name="AlphaSlider"
                Minimum="0.001" Maximum="1" Value="0.036"
                TickFrequency="0.001" IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="10" Grid.Column="2"
                 Text="{Binding ElementName=AlphaSlider, Path=Value, StringFormat=F3}"
                 VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="11" Text="N:" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="11" Grid.Column="1" x:Name="NSlider"
                Minimum="1" Maximum="10" Value="1.56"
                TickFrequency="0.1" IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="11" Grid.Column="2"
                 Text="{Binding ElementName=NSlider, Path=Value, StringFormat=F2}"
                 VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="12" Text="Ks:" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="12" Grid.Column="1" x:Name="KsSlider"
                Minimum="0" Maximum="0.01" Value="0.0058"
                TickFrequency="0.0005" IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="12" Grid.Column="2"
                 Text="{Binding ElementName=KsSlider, Path=Value, StringFormat=F4}"
                 VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="14" Text="Step Z (dz):" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="14" Grid.Column="1" x:Name="DzSlider"
                Minimum="0.001" Maximum="1" Value="0.02"
                TickFrequency="0.005" IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="14" Grid.Column="2"
                 Text="{Binding ElementName=DzSlider, Path=Value, StringFormat=F3}"
                 VerticalAlignment="Center"/>

                    <!-- Новый слайдер для dx -->
                    <TextBlock Grid.Row="15" Text="Step X (dx):" VerticalAlignment="Center"/>
                    <Slider   Grid.Row="15" Grid.Column="1" x:Name="DxSlider"
                Minimum="0.001" Maximum="1" Value="0.03"
                TickFrequency="0.005" IsSnapToTickEnabled="True"
                Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="15" Grid.Column="2"
                 Text="{Binding ElementName=DxSlider, Path=Value, StringFormat=F3}"
                 VerticalAlignment="Center"/>

                    <Button  Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="3"
               x:Name="ApplySettingsButton" Content="Применить"
               Width="100" Margin="0,10,0,0" HorizontalAlignment="Left"
               Click="ApplySettingsButton_Click"/>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</Window>
