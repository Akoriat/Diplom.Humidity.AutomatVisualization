<Window x:Class="UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Моделирование увлажнения почвы" Height="600" Width="800">
    <TabControl>
        <TabItem Header="Simulation">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="White" BorderBrush="Black" BorderThickness="1" Margin="5,5,5,5">
                    <Image Name="SimulationImage" Stretch="Fill" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,10,10,10">
                    <TextBlock Text="Легенда:" FontWeight="Bold" Margin="0 0 0 5"/>
                    <StackPanel Orientation="Horizontal" Margin="0 2">
                        <Rectangle Width="20" Height="20" Fill="White" Stroke="Black"/>
                        <TextBlock Text=" – Сухая почва" VerticalAlignment="Center" Margin="5 0 0 0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 2">
                        <Rectangle Width="20" Height="20" Fill="LightBlue" Stroke="Black"/>
                        <TextBlock Text=" – Умеренная влажность" VerticalAlignment="Center" Margin="5 0 0 0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 2">
                        <Rectangle Width="20" Height="20" Fill="Blue" Stroke="Black"/>
                        <TextBlock Text=" – Максимальная влажность" VerticalAlignment="Center" Margin="5 0 0 0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 2">
                        <Rectangle Width="20" Height="20" Fill="Black"/>
                        <TextBlock Text=" – Трещина" VerticalAlignment="Center" Margin="5 0 0 0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="167,5,0,5" >
                    <Button Name="StartButton" Content="Пуск" Width="80" Margin="5" Click="StartButton_Click"/>
                    <Button Name="StopButton" Content="Стоп" Width="80" Margin="5" Click="StopButton_Click"/>
                    <Button Name="SaveButton" Content="Сохранить" Width="80" Margin="5" Click="SaveButton_Click"/>
                    <Button Name="LoadButton" Content="Загрузить" Width="80" Margin="5" Click="LoadButton_Click"/>
                    <Button Name="RestartButton" Content="Рестарт" Width="80" Margin="5" Click="RestartButton_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Settings" Height="22" Margin="-2,-2,-2,0" VerticalAlignment="Top">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <TextBlock Text="Ширина сетки:" Width="150" VerticalAlignment="Center"/>
                    <Slider Name="WidthSlider" Minimum="10" Maximum="500" Value="100" Width="200" 
                            TickFrequency="10" IsSnapToTickEnabled="True" Margin="5 0"/>
                    <TextBlock Text="{Binding ElementName=WidthSlider, Path=Value, StringFormat=N0}" 
                               Width="40" VerticalAlignment="Center" Margin="5 0 0 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <TextBlock Text="Высота сетки:" Width="150" VerticalAlignment="Center"/>
                    <Slider Name="HeightSlider" Minimum="10" Maximum="200" Value="100" Width="200" 
                            TickFrequency="10" IsSnapToTickEnabled="True" Margin="5 0"/>
                    <TextBlock Text="{Binding ElementName=HeightSlider, Path=Value, StringFormat=N0}" 
                               Width="40" VerticalAlignment="Center" Margin="5 0 0 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <TextBlock Text="Проницаемость (K):" Width="150" VerticalAlignment="Center"/>
                    <Slider Name="ConductivitySlider" Minimum="0" Maximum="1" Value="0.1" Width="200" 
                            TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="5 0"/>
                    <TextBlock Text="{Binding ElementName=ConductivitySlider, Path=Value, StringFormat=F2}" 
                               Width="40" VerticalAlignment="Center" Margin="5 0 0 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <TextBlock Text="Шаг времени (dt):" Width="150" VerticalAlignment="Center"/>
                    <Slider Name="TimeStepSlider" Minimum="0" Maximum="1" Value="0.1" Width="200" 
                            TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="5 0"/>
                    <TextBlock Text="{Binding ElementName=TimeStepSlider, Path=Value, StringFormat=F2}" 
                               Width="40" VerticalAlignment="Center" Margin="5 0 0 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <TextBlock Text="Начальная влажность (%):" Width="150" VerticalAlignment="Center"/>
                    <Slider Name="InitialMoistureSlider" Minimum="0" Maximum="100" Value="50" Width="200" 
                            TickFrequency="10" IsSnapToTickEnabled="True" Margin="5 0"/>
                    <TextBlock Text="{Binding ElementName=InitialMoistureSlider, Path=Value, StringFormat=N0}" 
                               Width="40" VerticalAlignment="Center" Margin="5 0 0 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 5">
                    <TextBlock Text="Вероятность трещин (%):" Width="150" VerticalAlignment="Center"/>
                    <Slider Name="CrackChanceSlider" Minimum="1" Maximum="100" Value="1" Width="200" 
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="5 0"/>
                    <TextBlock Text="{Binding ElementName=CrackChanceSlider, Path=Value, StringFormat=N0}" 
                               Width="40" VerticalAlignment="Center" Margin="5 0 0 0"/>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="12">
                    <TextBlock Text="Дождь (мм/шаг)" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Slider
                    Width="200" ValueChanged="RainSlider_ValueChanged" Value="5" TickPlacement="BottomRight" TickFrequency="5" SmallChange="0.5" x:Name="RainSlider" Minimum="0" Maximum="200" LargeChange="1" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding ElementName=RainSlider,
                              Path=Value,
                              StringFormat='{}{0:F1} мм'}"
               FontSize="12"
               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
