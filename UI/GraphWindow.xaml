<Window x:Class="UI.GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:lcs="clr-namespace:LiveChartsCore.SkiaSharpView;assembly=LiveChartsCore.SkiaSharpView"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="График влажности" Height="400" Width="600">

    <!-- 1) Ресурсы: массивы осей -->
    <Window.Resources>
        <x:Array x:Key="XAxesArray" Type="{x:Type lcs:Axis}">
            <lcs:Axis Name="Шаг симуляции, ед. (t)" />
        </x:Array>
        <x:Array x:Key="YAxesArray" Type="{x:Type lcs:Axis}">
            <lcs:Axis Name="Влажность θ, доли" MinLimit="0" MaxLimit="1" />
        </x:Array>
    </Window.Resources>

    <Grid Margin="10">
        <lvc:CartesianChart
        Series="{Binding MoistureSeries}"
        ZoomMode="X"
        LegendPosition="Right"
        TooltipPosition="Top"
        XAxes="{StaticResource XAxesArray}"
        YAxes="{StaticResource YAxesArray}">
            <!-- Больше ничего здесь не нужно -->
        </lvc:CartesianChart>
    </Grid>
</Window>
